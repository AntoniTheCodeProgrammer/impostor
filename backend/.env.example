# Skopiuj ten plik jako .env i uzupełnij wartościami

# Turso (libSQL) – URL bazy danych i token autoryzacyjny
# Token wygenerujesz poleceniem: turso db tokens create impostor
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sekret do tworzenia konta admina (endpoint /admin/seed).
# Wymyśl własny, długi ciąg znaków. Wartość "impostor-secret" jest publiczna i jest odrzucana.
ADMIN_SEED_SECRET=

# (opcjonalnie) Klucz podpisujący sesje. Bez niego jest wyliczany z TURSO_AUTH_TOKEN.
# TOKEN_SECRET=
